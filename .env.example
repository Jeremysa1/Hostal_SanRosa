# Copia este archivo como .env y completa los valores.

DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Solo se usa con DEBUG=False
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com

# Base de datos: usa DATABASE_URL o, si está vacía, las variables DB_*
DATABASE_URL=
DB_NAME=hostal_sanrosa_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Cloudinary (obligatorias)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Número de WhatsApp del hostal (formato internacional, sin +)
HOSTAL_WHATSAPP=573242989045
